{
  "name": "clasi-app",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-gifted-charts|gifted-charts-core)"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^firebase/(.*)": "<rootDir>/src/tests/__mocks__/firebase.ts",
      "^../handlers/classifications/getClassification$": "<rootDir>/src/tests/__mocks__/handlers/classifications/getClassification",
      "^../handlers/classifications/createSeedClassification$": "<rootDir>/src/tests/__mocks__/handlers/classifications/createSeedClassification",
      "^../handlers/users/getUsers$": "<rootDir>/src/tests/__mocks__/handlers/getUsers",
      "^../services/reports$": "<rootDir>/src/tests/__mocks__/handlers/reports",
      "^../services/classifications$": "<rootDir>/src/tests/__mocks__/services/classifications",
      "^../handlers/suppliers/getSuppliers$": "<rootDir>/src/tests/__mocks__/handlers/suppliers/getSuppliers"
    }
  },
  "dependencies": {
    "@babel/preset-env": "^7.24.6",
    "@react-native-firebase/app": "^18.7.1",
    "@react-native-picker/picker": "2.7.5",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.1",
    "axios": "^1.6.2",
    "babel-jest": "^29.7.0",
    "expo": "^51.0.0",
    "expo-camera": "~15.0.6",
    "expo-file-system": "^17.0.1",
    "expo-image": "~1.12.9",
    "expo-linear-gradient": "~13.0.2",
    "expo-media-library": "~16.0.3",
    "expo-sharing": "^12.0.1",
    "expo-status-bar": "~1.12.1",
    "firebase": "^10.6.0",
    "firebase-tools": "^9.0.0",
    "moment": "^2.29.4",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-gifted-charts": "^1.4.10",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-vector-icons": "^10.0.2",
    "react-native-view-shot": "^3.8.0",
    "ts-jest": "^29.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-typescript": "^7.24.6",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.14",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.2",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true
}